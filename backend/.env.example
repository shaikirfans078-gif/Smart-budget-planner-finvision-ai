# FinVision local/server configuration. No Supabase credentials are used.

# ---- Database (Neon PostgreSQL) ----
# Paste your Neon *pooled* connection string here (Neon dashboard > Connect).
# Leave empty to use the local JSON file store (data/finvision.json) instead.
# NEVER commit this file or share the real string in chat/screenshots.
DATABASE_URL=
# Optional: PG_POOL_MAX=10

# JWT secrets - REQUIRED for production. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Initial administrator account. The server creates/promotes this account on startup.
# Leave both empty to disable admin mode. Use a unique password of 12+ characters.
ADMIN_NAME=FinVision Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server
PORT=3000

# Optional: restrict which sites may call the API from a browser (comma-separated). Empty = allow all.
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: how many times to retry the first database connection (Neon wakes from idle). Default 4.
# DB_INIT_RETRIES=4

# Set when deployed behind a reverse proxy / PaaS (Render, Railway, nginx) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# ---- Email (verification + password-reset one-time codes) ----
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your address>,
# SMTP_PASS=<a Google "App Password", not your normal password> (needs 2-Step Verification on).
# Leave SMTP_* empty while developing: codes are then printed in the server console.
# With NODE_ENV=production, SMTP is required (sign-up and password reset return 503 without it).
# ---- Email provider option A: EmailJS (recommended if you have an EmailJS account) ----
# Needs all four. In EmailJS: Account > Security > enable "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---- Email provider option B: SMTP (used only if EmailJS above is not fully set) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=60
# NODE_ENV=production   # needs ADMIN_PASSWORD 12+ chars and an email provider
